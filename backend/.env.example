# ===== Servidor =====
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# ===== Base de datos (MySQL/MariaDB) =====
DATABASE_URL="mysql://mis_gastos:mis_gastos@localhost:3306/mis_gastos"

# ===== Seguridad / tokens (se usan en la Fase 2) =====
ACCESS_TOKEN_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# ===== Google OAuth (Fase 2) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ===== Email (Fase 2) =====
# console = imprime el correo en la consola (dev) | smtp = envía de verdad
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mis Gastos <no-reply@misgastos.app>"

# ===== Super administrador (seed, Fase 2) =====
SUPER_ADMIN_EMAIL=admin@misgastos.app
SUPER_ADMIN_PASSWORD=cambia-esta-contrasena
