# ===== Servidor =====
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# ===== Base de datos (MySQL/MariaDB de XAMPP) =====
# Usuario root sin contraseña (por defecto en XAMPP). Ajusta si configuraste otra.
DATABASE_URL="mysql://root:@localhost:3306/mis_gastos"

# ===== Seguridad / tokens =====
# Genera un secreto largo y aleatorio (mínimo 32 caracteres)
ACCESS_TOKEN_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ===== Email =====
# console = imprime el correo en la consola (dev) | smtp = envía de verdad
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mis Gastos <no-reply@misgastos.app>"

# ===== Super administrador (seed) =====
SUPER_ADMIN_EMAIL=admin@misgastos.app
SUPER_ADMIN_PASSWORD=cambia-esta-contrasena
